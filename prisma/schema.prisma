generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id          String   @id @default(uuid())
  shopDomain  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  accessToken String?
  plan        String   @default("BASIC")
}

model Banner {
  id         String   @id @default(uuid())
  shopDomain String
  name       String
  templateId String   @default("template-1")
  status     String   @default("ACTIVE")
  settings   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Subscription {
  id                    String   @id @default(uuid())
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  plan                  String
  shopDomain            String
  shopifySubscriptionId String?
  updatedAt             DateTime @updatedAt
}

model Template {
  id           String   @id
  name         String
  createdAt    DateTime @default(now())
  description  String?
  plan         String
  previewImage String?
  settings     String
  updatedAt    DateTime @updatedAt
}

model StoreSettings {
  id                String   @id @default(uuid())
  shopDomain        String   @unique
  defaultAnimation  String   @default("Right to Left")
  defaultSpeed      String   @default("Normal")
  defaultHeight     Int      @default(40)
  defaultBgColor    String   @default("#19D8CF")
  defaultTextColor  String   @default("#111827")
  defaultHoverColor String   @default("#06B6D4")
  reduceMotion      Boolean  @default(false)
  pauseOnHover      Boolean  @default(true)
  pauseOnFocus      Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}
